rules_version = '2';

// BullBir — Cloud Storage security rules.
// Deploy: `firebase deploy --only storage` (or paste into Firebase Console → Storage → Rules).
service firebase.storage {
  match /b/{bucket}/o {

    // Avatar: one file per user at avatars/{uid}. Owner-only write, verified accounts only
    // (`bb_ev` claim from our server's custom token); images under 2 MB.
    // Read stays owner-only too — the app shows the avatar via its download URL (token-bearing).
    // Same credential-version check as firestore.rules (cross-service read of auth_state/{uid}).
    function freshCredentials(uid) {
      return !firestore.exists(/databases/(default)/documents/auth_state/$(uid))
        || request.auth.token.get('bb_cv', 0) >= firestore.get(/databases/(default)/documents/auth_state/$(uid)).data.cv;
    }

    // Only Firebase sessions minted by our auth server (custom tokens).
    function viaOurServer() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    match /avatars/{uid} {
      allow read, delete: if viaOurServer() && request.auth.uid == uid && freshCredentials(uid);
      allow write: if viaOurServer() && request.auth.uid == uid && freshCredentials(uid)
        && request.auth.token.get('bb_ev', false) == true
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }

    // Deny-by-default for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
