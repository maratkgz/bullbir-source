rules_version = '2';

// BullBir — Cloud Storage security rules.
// Deploy: `firebase deploy --only storage` (or paste into Firebase Console → Storage → Rules).
service firebase.storage {
  match /b/{bucket}/o {

    // Avatar: one file per user at avatars/{uid}. Owner-only write; images under 2 MB.
    // Read stays owner-only too — the app shows the avatar via its download URL (token-bearing).
    match /avatars/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }

    // Deny-by-default for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
