rules_version = '2';

// BullBir — Firestore security rules.
// Deploy: `firebase deploy --only firestore:rules` (or paste into Firebase Console → Firestore → Rules).
//
// Model: every piece of data lives under users/{uid}/... and is readable/writable ONLY by that uid.
// Everything not explicitly matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Only Firebase sessions minted by our auth server (custom tokens). A session obtained directly
    // from Firebase Auth (old password, Google popup, phone) via the public API key gets nothing.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Firebase sessions come only from our server's custom tokens (/api/auth/firebase-token),
    // which carry `bb_ev` = the account's verified-email flag. Firebase's own `email_verified`
    // is ignored on purpose. Mirrors the client `isVerified` gate (AuthContext).
    function isVerified() {
      return request.auth.token.get('bb_ev', false) == true;
    }

    // Credential version (server/auth/credentials.ts): after a password/email change, "sign out
    // everywhere" or account deletion the server bumps auth_state/{uid}.cv; bridge tokens minted
    // before carry a smaller `bb_cv` and lose access at once (Firebase ID tokens would otherwise
    // stay valid for up to an hour). Costs one document read per rule evaluation.
    function freshCredentials(uid) {
      return !exists(/databases/$(database)/documents/auth_state/$(uid))
        || request.auth.token.get('bb_cv', 0) >= get(/databases/$(database)/documents/auth_state/$(uid)).data.cv;
    }

    // Collections the app is allowed to store. Keep in sync with USER_COLLECTIONS
    // in src/firebase/account.js. Anything else is rejected.
    function isKnownCollection(col) {
      return col in [
        'tasks', 'journalEntries', 'events', 'transactions', 'moods', 'notes',
        'goals', 'habits', 'pomodoro', 'reminders', 'shifts', 'savingsGoals',
        'mandalas', 'aiState'
      ];
    }

    // Admins are listed in /admins/{uid}; that collection is edited only in the Firebase
    // console (client writes are denied below), so nobody can make themselves an admin.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Guard against abuse: cap the number of top-level fields per document.
    function reasonableSize() {
      return request.resource.data.size() <= 60;
    }

    function allowedProfileFields() {
      return request.resource.data.keys().hasOnly([
        'email', 'displayName', 'photoURL', 'phone', 'onboardingDone', 'createdAt',
        'language', 'theme', 'bio', 'birthDate', 'firstName', 'lastName'
      ]);
    }

    // Root profile doc. Created right after sign-up, before the email is verified.
    match /users/{uid} {
      allow read, delete: if isOwner(uid) && freshCredentials(uid);
      allow create: if isOwner(uid) && freshCredentials(uid) && reasonableSize() && allowedProfileFields();
      // Identity and creation metadata are server-owned and cannot be changed by clients.
      allow update: if isOwner(uid) && freshCredentials(uid) && reasonableSize() && allowedProfileFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phone', 'onboardingDone', 'language', 'theme',
          'bio', 'birthDate', 'firstName', 'lastName'
        ]);
    }

    // Per-user module data — only after verification.
    match /users/{uid}/{col}/{docId} {
      allow read, delete: if isOwner(uid) && isVerified() && isKnownCollection(col) && freshCredentials(uid);
      allow create, update: if isOwner(uid) && isVerified() && isKnownCollection(col)
        && freshCredentials(uid) && reasonableSize();
    }

    // A user may only check whether they themselves are an admin.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Assistant knowledge library edited from the in-app admin page. Readable by every
    // verified user (it is shared content, not personal data); writable by admins only.
    match /aiDomains/{id} {
      allow read: if signedIn() && isVerified();
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && reasonableSize()
        && request.resource.data.id == id
        && (request.resource.data.get('disabled', false) == true
            || request.resource.data.directions.size() == 8);
    }
    match /aiIntents/{id} {
      allow read: if signedIn() && isVerified();
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && reasonableSize() && request.resource.data.id == id;
    }

    // Authentication records are Admin SDK only. Keep explicit denies in addition to the
    // catch-all so a future broad match cannot accidentally expose credentials or sessions.
    match /users_auth/{id} { allow read, write: if false; }
    match /auth_emails/{id} { allow read, write: if false; }
    match /sessions/{id} { allow read, write: if false; }
    match /otp_codes/{id} { allow read, write: if false; }
    match /auth_accounts/{id} { allow read, write: if false; }
    match /security_events/{id} { allow read, write: if false; }
    match /auth_throttle/{id} { allow read, write: if false; }
    match /auth_state/{id} { allow read, write: if false; }

    // Deny-by-default for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
