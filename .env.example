# Server-only settings. Copy to .env.local for local development.
# Leave secrets empty in this template; generate local values yourself.
NODE_ENV=development
FIREBASE_PROJECT_ID=demo-bullbir
APP_ORIGINS=http://localhost:5173
AUTH_PEPPER=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_SERVICE_ACCOUNT_BASE64=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
# Browser side of local development: point the app at the emulators (dev server only).
VITE_USE_EMULATORS=true
# Firebase password-hash parameters (stage 3 migration). Required in production.
FIREBASE_HASH_SIGNER_KEY=
FIREBASE_HASH_SALT_SEPARATOR=
FIREBASE_HASH_ROUNDS=
FIREBASE_HASH_MEM_COST=
# Google sign-in (stage 5, docs/google-oauth-setup.md). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=
