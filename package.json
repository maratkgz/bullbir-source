{
  "name": "bullbir",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "BullBir — all-in-one personal productivity web app (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-bullbir \"vitest run -c vitest.emulator.config.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-bullbir",
    "typecheck": "tsc -p tsconfig.server.json",
    "migrate:users": "node scripts/migrate-users.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "2.2.2",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "date-fns": "^3.6.0",
    "firebase": "^10.12.2",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^11.2.10",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "resend": "6.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^7.0.2",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
